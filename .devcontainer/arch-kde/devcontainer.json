{
    "name": "Dotfiles Archlinux KDE (WebTop)",
    "image": "ghcr.io/zyrakq/arch-devcontainer-images/arch-webtop-kde-common:latest",
    "workspaceFolder": "/config/.dotfiles",
    "workspaceMount": "source=dotfiles-arch-kde-workspace,target=/config/.dotfiles,type=volume",
    "mounts": [
        "source=dotfiles-arch-kde-home,target=/config,type=volume"
    ],
    "remoteUser": "abc",
    "remoteEnv": {
        "HOME": "/config"
    },
    "containerEnv": {
        "PUID": "1000",
        "PGID": "1000",
        "TZ": "Etc/UTC",
        "TITLE": "Dotfiles Archlinux KDE"
    },
    "overrideCommand": false,
    "runArgs": [
        "--name=dotfiles-arch-kde-devcontainer",
        "--hostname=dotfiles-arch-kde",
        "--network=dotfiles-arch-kde-workspace-network",
        "--security-opt",
        "seccomp=unconfined",
        "--shm-size=1gb"
    ],
    "initializeCommand": [
        "bash",
        "-c",
        "docker network ls | grep -q dotfiles-arch-kde-workspace-network || docker network create dotfiles-arch-kde-workspace-network"
    ],
    "forwardPorts": [
        3000,
        3001
    ],
    "portsAttributes": {
        "3000": {
            "label": "Desktop Environment (HTTP)",
            "onAutoForward": "openBrowser"
        },
        "3001": {
            "label": "Desktop Environment (HTTPS)",
            "onAutoForward": "openBrowser"
        }
    },
    "features": {
        "ghcr.io/zyrakq/arch-devcontainer-features/clone-repo:1": {
            "repoUrl": "git@github.com:zeritiq/dotfiles.git",
            "targetDir": "/config/.dotfiles"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                // VSCode
                "vscode-icons-team.vscode-icons",
                "aaron-bond.better-comments",
                "IBM.output-colorizer",
                "bierner.markdown-mermaid",
                // Docker
                "ms-azuretools.vscode-docker",
                // Git
                "eamodio.gitlens",
                "codezombiech.gitignore",
                "jock.svg",
                "kamikillerto.vscode-colorize",
                // For Dotfiles
                "rogalmic.bash-debug",
                "rhaiscript.vscode-rhai",
                "tamasfe.even-better-toml",
                // AI Assistant
                "saoudrizwan.claude-dev"
            ]
        }
    }
}